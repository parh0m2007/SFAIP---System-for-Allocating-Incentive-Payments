# Static frontend served by nginx. Build args:
#   NGINX_CONF - nginx config to bake in: nginx.conf (default, HTTP only) or nginx-ssl.conf (HTTPS)
#   DOMAIN     - Let's Encrypt domain substituted into the SSL config (e.g. school.example.ru)
FROM nginx:alpine
ARG NGINX_CONF=nginx.conf
ARG DOMAIN=localhost
COPY ${NGINX_CONF} /etc/nginx/conf.d/default.conf.tpl
RUN if grep -q '__DOMAIN__' /etc/nginx/conf.d/default.conf.tpl; then \
        sed -i "s/__DOMAIN__/${DOMAIN}/g" /etc/nginx/conf.d/default.conf.tpl; \
    fi && \
    mv /etc/nginx/conf.d/default.conf.tpl /etc/nginx/conf.d/default.conf
COPY index.html /usr/share/nginx/html/index.html
COPY src /usr/share/nginx/html/src
EXPOSE 80
