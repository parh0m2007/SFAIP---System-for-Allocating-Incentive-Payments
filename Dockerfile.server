# Stage 1: install dependencies and generate the Prisma client
FROM node:20-alpine AS deps
WORKDIR /app
COPY server/package.json server/package-lock.json ./
# Schema must be present before generate: @prisma/client's postinstall skips
# generation when it cannot find the schema, leaving only the stub without enums.
COPY server/prisma ./prisma
RUN npm ci && npx prisma generate

# Stage 2: production runtime
FROM node:20-alpine
WORKDIR /app
ENV NODE_ENV=production
COPY --from=deps /app/node_modules ./node_modules
COPY server/package.json server/package-lock.json ./
COPY server/prisma ./prisma
COPY server/src ./src
COPY server/tsconfig.json ./tsconfig.json
COPY server/types ./types

# tsx runs TypeScript directly; prisma CLI + engine binaries already in node_modules
EXPOSE 3001
CMD ["node", "--import", "tsx", "src/main.ts"]
