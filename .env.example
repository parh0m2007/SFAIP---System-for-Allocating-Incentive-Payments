# Docker compose environment. Copy to .env and fill in before `docker compose up`.
# Generate secrets: openssl rand -hex 32
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Host port for the nginx frontend (80 by default)
HTTP_PORT=80

# Allowed CORS origins, comma-separated. Not needed when the frontend is
# served by the same nginx that proxies /api (same origin).
CORS_ORIGINS=

# Your public domain - required only for the HTTPS overlay (docker-compose.https.yml)
DOMAIN=

# Brevo transactional email (optional - leave empty to disable)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Образовательная система
